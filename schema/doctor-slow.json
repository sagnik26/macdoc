{
  "$defs": {
    "engine.DoctorResult": {
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/engine.Finding"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "report": {
          "$ref": "#/$defs/probe.Report"
        }
      },
      "required": [
        "findings",
        "report"
      ],
      "type": "object"
    },
    "engine.Finding": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "title"
      ],
      "type": "object"
    },
    "engine.SlowGroup": {
      "properties": {
        "count": {
          "type": "integer"
        },
        "dev": {
          "type": "boolean"
        },
        "explain": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rss_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "count",
        "dev",
        "name",
        "rss_bytes"
      ],
      "type": "object"
    },
    "engine.SlowResult": {
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/engine.SlowGroup"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "health": {
          "$ref": "#/$defs/engine.DoctorResult"
        },
        "level": {
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "swap_history": {
          "$ref": "#/$defs/engine.SwapHistory"
        },
        "tips": {
          "items": {
            "$ref": "#/$defs/engine.SlowTip"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "verdict": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "groups",
        "health",
        "level",
        "swap_history",
        "verdict"
      ],
      "type": "object"
    },
    "engine.SlowTip": {
      "properties": {
        "group": {
          "type": "string"
        },
        "rss_bytes": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "group",
        "rss_bytes",
        "text"
      ],
      "type": "object"
    },
    "engine.SwapHistory": {
      "properties": {
        "critical_samples": {
          "type": "integer"
        },
        "days": {
          "type": "integer"
        },
        "low_bytes": {
          "type": "integer"
        },
        "peak_at": {
          "format": "date-time",
          "type": "string"
        },
        "peak_bytes": {
          "type": "integer"
        },
        "samples": {
          "type": "integer"
        },
        "since": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "critical_samples",
        "days",
        "low_bytes",
        "peak_bytes",
        "samples"
      ],
      "type": "object"
    },
    "model.Bytes": {
      "properties": {
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "source",
        "value"
      ],
      "type": "object"
    },
    "probe.Disk": {
      "properties": {
        "container_free_bytes": {
          "type": "integer"
        },
        "container_ref": {
          "type": "string"
        },
        "container_total_bytes": {
          "type": "integer"
        },
        "purgeable_bytes": {
          "$ref": "#/$defs/model.Bytes"
        },
        "volumes": {
          "items": {
            "$ref": "#/$defs/probe.Volume"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "container_free_bytes",
        "container_ref",
        "container_total_bytes",
        "purgeable_bytes",
        "volumes"
      ],
      "type": "object"
    },
    "probe.Hardware": {
      "properties": {
        "chip": {
          "type": "string"
        },
        "cpu_count": {
          "type": "integer"
        },
        "memory_bytes": {
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "os_build": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        }
      },
      "required": [
        "chip",
        "cpu_count",
        "memory_bytes",
        "model",
        "os_build",
        "os_version"
      ],
      "type": "object"
    },
    "probe.Memory": {
      "properties": {
        "active_bytes": {
          "type": "integer"
        },
        "compressed_bytes": {
          "type": "integer"
        },
        "free_bytes": {
          "type": "integer"
        },
        "free_percent": {
          "type": "integer"
        },
        "inactive_bytes": {
          "type": "integer"
        },
        "pressure": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer"
        },
        "wired_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "active_bytes",
        "compressed_bytes",
        "free_bytes",
        "free_percent",
        "inactive_bytes",
        "pressure",
        "total_bytes",
        "wired_bytes"
      ],
      "type": "object"
    },
    "probe.ProcessGroup": {
      "properties": {
        "count": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "rss_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "count",
        "name",
        "rss_bytes"
      ],
      "type": "object"
    },
    "probe.Report": {
      "properties": {
        "disk": {
          "$ref": "#/$defs/probe.Disk"
        },
        "hardware": {
          "$ref": "#/$defs/probe.Hardware"
        },
        "memory": {
          "$ref": "#/$defs/probe.Memory"
        },
        "snapshots": {
          "$ref": "#/$defs/probe.Snapshots"
        },
        "swap": {
          "$ref": "#/$defs/probe.Swap"
        },
        "top_processes": {
          "items": {
            "$ref": "#/$defs/probe.ProcessGroup"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "disk",
        "hardware",
        "memory",
        "snapshots",
        "swap",
        "top_processes"
      ],
      "type": "object"
    },
    "probe.Snapshots": {
      "properties": {
        "count": {
          "type": "integer"
        },
        "names": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "count",
        "names"
      ],
      "type": "object"
    },
    "probe.Swap": {
      "properties": {
        "encrypted": {
          "type": "boolean"
        },
        "free_bytes": {
          "type": "integer"
        },
        "total_bytes": {
          "type": "integer"
        },
        "used_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "encrypted",
        "free_bytes",
        "total_bytes",
        "used_bytes"
      ],
      "type": "object"
    },
    "probe.Volume": {
      "properties": {
        "mount_point": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "used_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "roles",
        "used_bytes"
      ],
      "type": "object"
    }
  },
  "$id": "https://macdoc.local/schema/doctor-slow.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "command": {
      "const": "doctor slow"
    },
    "data": {
      "$ref": "#/$defs/engine.SlowResult"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "const": "2"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "command",
    "generated_at",
    "data"
  ],
  "title": "macdoc doctor slow --json",
  "type": "object"
}
